# ---------------------------------------------------------------- iCloud account
# Apple ID you sign in with. Create the app-specific password at https://account.apple.com
# (Sign-In and Security > App-Specific Passwords). Never use your real Apple ID password here.
ICLOUD_USERNAME=you@icloud.com
ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# Address mail is sent from. Must be your iCloud address (or one of its aliases). Defaults to ICLOUD_USERNAME.
# Set this if your Apple ID is not an @icloud.com / @me.com address.
#ICLOUD_EMAIL_ADDRESS=you@icloud.com
ICLOUD_DISPLAY_NAME=Your Name
# Optional plain-text signature appended to everything the connector sends (\n = newline).
#EMAIL_SIGNATURE=Your Name\nhttps://example.com
DEFAULT_TIMEZONE=Europe/Berlin
# Calendar new events go to when the agent does not name one (default: 'Calendar' or 'Home', else the first calendar)
#DEFAULT_CALENDAR=Calendar
# CARDDAV_URL=https://contacts.icloud.com
# CARDDAV_USERNAME=          -> only if the CardDAV login name must differ from ICLOUD_USERNAME

# ---------------------------------------------------------------- this server
# Public HTTPS address Claude reaches the server at. No trailing slash, no path.
MCP_PUBLIC_URL=https://icloud-mcp.example.com
# Password YOU type on the consent page when connecting a client. 12+ random characters. NOT your Apple password.
MCP_OWNER_PASSWORD=change-me-to-a-long-random-string
# Cloudflare Tunnel (optional): put the token in a separate file .tunnel.env as TUNNEL_TOKEN=... and use the "tunnel" profile.

# ---------------------------------------------------------------- safety switches
# READ_ONLY=true            -> no sending, moving, deleting, calendar changes or contact changes (drafts disabled too)
# ALLOW_SEND=false          -> everything except sending; agents can still save drafts for you to review
# SEND_ALLOWLIST=@example.org,friend@example.com   -> only these addresses/domains may receive mail from the connector
# MAX_RECIPIENTS=25
# ENABLE_MAIL=true
# ENABLE_CALENDAR=true
# ENABLE_CONTACTS=true        -> contacts_search / contacts_get plus contact create/update/delete when READ_ONLY=false (CardDAV, same app-specific password)
# ALLOW_PERMANENT_DELETE=false
# --- Owner approval (prompt-injection defence) ---
# With ALLOW_SEND=true, mail_send / mail_reply / mail_forward only QUEUE the message. It is delivered only when the owner
# opens https://<your-host>/outbox, types MCP_OWNER_PASSWORD and presses Approve. Keep this true.
# SEND_REQUIRES_APPROVAL=true
# OUTBOX_TTL_SECONDS=86400    -> unapproved messages expire after this long and are never sent
# OUTBOX_MAX=20               -> max messages waiting for approval
# Calendar events with attendees make iCloud email people (invitations, updates, cancellations), which would bypass the gate.
# Blocked unless you opt in:
# ALLOW_CALENDAR_INVITES=false

# ---------------------------------------------------------------- iCloud behaviour
# The connector copies each sent message into the Sent folder itself. Run
#   python -m icloud_mcp.selftest --probe-sent you@icloud.com
# once. If it reports that iCloud already files sent mail by itself, set this to false to avoid duplicates.
SAVE_SENT_COPY=true

# ---------------------------------------------------------------- OAuth
# Redirect hosts clients may register. Add others (ChatGPT, Cursor, ...) if you connect them.
#OAUTH_ALLOWED_REDIRECT_HOSTS=claude.ai,claude.com,localhost,127.0.0.1
#ACCESS_TOKEN_TTL=3600
#REFRESH_TOKEN_TTL=2592000
