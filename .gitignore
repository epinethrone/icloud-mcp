# Deny by default: nothing is tracked unless it is listed below, so secrets, local config, caches and build output
# cannot be committed by accident (even with `git add -A`).
*
!.gitignore
!.github/
!.github/FUNDING.yml
!.github/dependabot.yml
!.github/workflows/
!.github/workflows/*.yml
!LICENSE
!README.md
!.env.example
!Dockerfile
!docker-compose.yml
!pyproject.toml
!packaging/
!packaging/mcpb/
!packaging/mcpb/*.py
!server.json
!glama.json
!configure.sh
!THIRD_PARTY_NOTICES.md
!mac-helper/
!mac-helper/*.py
!mac-helper/*.sh
!mac-helper/README.md
!mac-helper/ops/
!mac-helper/ops/*.js
!mac-helper/ops/*.py
!mac-helper/pdftext/
!mac-helper/pdftext/*.swift
!mac-helper/eventkit/
!mac-helper/eventkit/*.swift
!mac-helper/eventkit/Info.plist
!src/
!src/icloud_mcp/
!src/icloud_mcp/*.py
!src/icloud_mcp/static/
!src/icloud_mcp/static/README.md
!src/icloud_mcp/static/favicon.ico
!src/icloud_mcp/static/icon-180.png
!src/icloud_mcp/static/icon-32.png
!assets/
!assets/logo.svg
!assets/logo-512.png
!assets/social-preview.png
!assets/readme/
!assets/readme/*.svg
!tests/
!tests/*.py
!tests/*.js
!tests/integration/
!tests/integration/*.py
!dev/
!dev/*.py
!dev/*.conf
!dev/*.sh
!docs/
!docs/*.md

# Belt and braces: these must never be tracked, whatever the rules above say.
.env
.env.*
!.env.example
.tunnel.env
*.pem
*.key
data/
oauth_state.json
outbox.json
__pycache__/
*.egg-info/
build/
.venv/
.pytest_cache/
